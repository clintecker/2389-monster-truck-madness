{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "2389-monster-truck-madness",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // Rebuild for every deploy, including direct Wrangler invocations.
  "build": { "command": "python3 tools/build.py" },
  // Serve the complete offline-compatible game without a Worker script.
  "assets": { "directory": "./dist", "not_found_handling": "none" }
}
